{
  "name": "@woo/storefront-react",
  "version": "0.1.0",
  "description": "React hooks and hydration helpers for @woo/storefront-core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@woo/storefront-core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@woo/storefront-browser": "workspace:*",
    "happy-dom": "20.14.6"
  }
}
