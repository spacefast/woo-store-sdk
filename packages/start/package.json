{
  "name": "@woo/storefront-start",
  "version": "0.1.0",
  "description": "TanStack Start adapter: server routes, cookie session, cache wiring.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/start-server-core": "1.169.17",
    "@woo/storefront-core": "workspace:*",
    "@woo/storefront-react": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1",
    "react": ">=18",
    "@tanstack/react-query": ">=5"
  }
}
