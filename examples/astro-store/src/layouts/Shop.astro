---
import '../styles.css'
const { title = 'Quiet Press' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="same-origin" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header"><a class="wordmark" href="/">Quiet Press<span>Books for the slower path.</span></a><a href="/cart/">Your bag <span aria-hidden="true">↗</span></a></header>
    <main><slot /></main>
    <footer><a href="/">Quiet Press</a><p>A little less scrolling. A little more looking.</p><a href="/cart/">Your bag</a></footer>
  </body>
</html>
