{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "preserveSymlinks": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@woo/storefront-core": ["./packages/core/src/index.ts"],
      "@woo/storefront-react": ["./packages/react/src/index.ts"]
    }
  }
}
