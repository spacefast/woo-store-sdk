{
  "name": "woocommerce/woo-storefront",
  "description": "WooCommerce feature plugin for headless storefronts.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "WooStorefront\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WooStorefront\\Tests\\": "tests/"
    }
  }
}
