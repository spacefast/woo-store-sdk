{
  "name": "woo-store-sdk",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:shop": "pnpm --filter woo-store-shop build",
    "dev:shop": "pnpm --filter woo-store-shop dev",
    "test": "pnpm -r --filter './packages/**' test",
    "test:e2e:sdk": "node e2e/store-e2e.mjs",
    "test:e2e:shop": "node e2e/shop-e2e.mjs",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "lint": "pnpm -r --if-present lint",
    "test:shop": "pnpm --filter woo-store-shop test"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-start": "1.168.32",
    "@types/node": "22.19.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
